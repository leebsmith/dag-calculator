    "rel_mash_thickness_below_ceiling" [id="rel_mash_thickness_below_ceiling", label="mash_thickness_below_ceiling", tooltip="(solver.batch.mash_thickness_l_per_kg <= constants.max_mash_thickness_l_per_kg)", fontsize="9", shape="diamond", style="dashed,filled", fillcolor="#fff8e1", color="#ef6c00"];
