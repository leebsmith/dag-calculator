{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sugar-fermentability.schema.json",
  "title": "Audited brewing sugar database",
  "$comment": "Pinned shape for data/sources/sugar-fermentability.json. Bump schema_version on a breaking change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "upstream", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "upstream": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "aliases",
        "form",
        "dry_matter_fraction",
        "extract_efficiency_factor",
        "ppg_as_is",
        "l_deg_per_kg",
        "rdf",
        "rdf_min",
        "rdf_max",
        "basis",
        "method",
        "vendor",
        "url",
        "retrieved_at",
        "sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "form": { "type": "string", "enum": ["dry", "liquid"] },
        "dry_matter_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "extract_efficiency_factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.05 },
        "ppg_as_is": { "type": "number", "exclusiveMinimum": 0, "maximum": 46.5 },
        "l_deg_per_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 388 },
        "rdf": { "type": "number", "minimum": 0, "maximum": 1 },
        "rdf_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "rdf_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "sulfated_ash_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "carbohydrate_profile": { "type": ["string", "null"], "minLength": 1 },
        "basis": { "const": "real" },
        "method": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "notes": { "type": "string" },
        "provenance_note": { "type": "string" }
      }
    }
  }
}
