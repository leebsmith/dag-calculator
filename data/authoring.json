{
  "schema_version": 1,
  "transforms": {
    "hamilton": {
      "owner": "frontend/src/views/hamilton.js",
      "when": "before the engine reads an authored parts pool: parts become pct and w_i"
    },
    "sugar-share": {
      "owner": "frontend/src/views/producer/sugarAllocation.js",
      "when": "before the engine reads the sugar budget: parts become a share of extract"
    },
    "prior-resolution": {
      "owner": "frontend/src/engine/ingredientPriors.js",
      "when": "on ingest: a missing yield or fermentability figure takes the category prior"
    },
    "mash-preset": {
      "owner": "frontend/src/views/mash.js",
      "when": "when a preset is applied: rest rows are replaced as one authored action"
    },
    "scale-pin": {
      "owner": "frontend/src/views/styleTargetsLogic.js",
      "when": "before a pin edit commits: the target is clamped to the feasible ray"
    }
  },
  "actions": {
    "batch.attenuation_derate_points": {
      "action": "set",
      "constraint": "domain",
      "transform": [],
      "note": "authored scalar; domain $value >= 0 && $value <= 0.25"
    },
    "batch.boil_hops": {
      "action": "edit-table",
      "constraint": "schema",
      "transform": [
        "hamilton"
      ],
      "note": "rows conform to boil_hop_row"
    },
    "batch.boil_off_rate_l_per_hr": {
      "action": "override",
      "constraint": "domain",
      "transform": [],
      "note": "inherits a default until overridden; domain $value > 0"
    },
    "batch.boil_time_min": {
