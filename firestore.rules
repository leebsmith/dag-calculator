rules_version = '2';

// Deny all client access. The browser is an Auth-only Firebase client: every
// read and write to Firestore goes through the FastAPI backend using the
// Firebase Admin SDK, which bypasses these rules. Deny-by-default guarantees
// that the public project config (shipped in the frontend bundle) cannot be
// used to reach user data directly, even if the database were left in test mode.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
